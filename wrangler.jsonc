{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beautyproof",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "beautyproof"
    }
  ],
  "ratelimits": [
    {
      "name": "YOUCAM_USER_RATE_LIMITER",
      "namespace_id": "826082601",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "YOUCAM_SITE_RATE_LIMITER",
      "namespace_id": "826082602",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
