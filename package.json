{
  "name": "@closure/beautyproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3026",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:e2e": "next build && node scripts/run-e2e.mjs",
    "screenshots": "next build && node scripts/capture-screenshots.mjs",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run --keep-vars",
    "seed": "tsx scripts/seed.ts",
    "check:persistence": "tsx scripts/check-persistence.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/supabase-js": "^2.112.0",
    "next": "16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.119.0"
  }
}
